#!/bin/bash
set -euxo pipefail
apt-get update
apt-get install -y haproxy nginx
snap install aws-cli --classic                 # 파라미터를 읽으려면 먼저 필요

# 점검 페이지(nginx)는 8080, 80은 HAProxy가 사용
sed -i 's/listen 80 default_server;/listen 8080 default_server;/; s/listen \[::\]:80 default_server;/listen [::]:8080 default_server;/' /etc/nginx/sites-available/default
echo "jammy (${hostname}): 점검 중입니다 (all sites down)" > /var/www/html/index.html
systemctl restart nginx

# HAProxy 설정 적용 스크립트: 부팅 때와 Run Command 때 같이 사용 (#43)
cat > /usr/local/bin/haproxy-apply <<'APPLY'
#!/bin/bash
set -euo pipefail
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
/snap/bin/aws ssm get-parameter --region ap-northeast-2 \
  --name ${cfg_param} --query Parameter.Value --output text | cat > "$tmp"
[ -s "$tmp" ] || { echo "빈 설정 수신, 중단" >&2; exit 1; }
haproxy -c -f "$tmp"                           # 문법 검사 실패 시 종료, 기존 설정 유지
install -m 644 "$tmp" /etc/haproxy/haproxy.cfg
systemctl reload haproxy
APPLY
chmod +x /usr/local/bin/haproxy-apply
/usr/local/bin/haproxy-apply

# --- Tailscale ---
curl -fsSL https://tailscale.com/install.sh | sh

set +x                                         # 키가 로그에 찍히지 않게
TS_KEY=$(aws ssm get-parameter --region ap-northeast-2 \
  --name ${ts_param} --with-decryption \
  --query Parameter.Value --output text)
tailscale up --authkey "$TS_KEY" --hostname ${hostname} \
  --advertise-tags=tag:edge --accept-routes
unset TS_KEY
set -x
