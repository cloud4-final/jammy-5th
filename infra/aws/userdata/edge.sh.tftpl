#!/bin/bash
set -euxo pipefail
hostnamectl set-hostname ${hostname}
apt-get update
apt-get install -y haproxy nginx wireguard-tools
snap install aws-cli --classic

# SSM 조회: 실패 시 5회 재시도 (첫 부팅 IAM 반영 지연 대비, #46 보강①)
cat > /usr/local/bin/ssm-get <<'GET'
#!/bin/bash
set -uo pipefail
name=$1; shift
for i in 1 2 3 4 5; do
  /snap/bin/aws ssm get-parameter --region ap-northeast-2 --name "$name" "$@" \
    --query Parameter.Value --output text && exit 0
  echo "SSM 조회 실패($i/5): $name" >&2
  sleep $((i * 5))
done
exit 1
GET
chmod +x /usr/local/bin/ssm-get

# 점검 페이지(nginx)는 8080, 80은 HAProxy
sed -i 's/listen 80 default_server;/listen 8080 default_server;/; s/listen \[::\]:80 default_server;/listen [::]:8080 default_server;/' /etc/nginx/sites-available/default
echo "jammy (${hostname}): 점검 중입니다 (all sites down)" > /var/www/html/index.html
systemctl restart nginx

# HAProxy 설정 적용: reload 실패 시 이전 설정 복원 (#43, #46 보강②)
cat > /usr/local/bin/haproxy-apply <<'APPLY'
#!/bin/bash
set -euo pipefail
tmp=$(mktemp); bak=$(mktemp)
trap 'rm -f "$tmp" "$bak"' EXIT
/usr/local/bin/ssm-get ${cfg_param} | cat > "$tmp"   # snap aws는 파이프로 받아야 안전
[ -s "$tmp" ] || { echo "빈 설정 수신, 중단" >&2; exit 1; }
haproxy -c -f "$tmp"
cp /etc/haproxy/haproxy.cfg "$bak"
install -m 644 "$tmp" /etc/haproxy/haproxy.cfg
if ! systemctl reload haproxy; then
  echo "reload 실패, 이전 설정 복원" >&2
  install -m 644 "$bak" /etc/haproxy/haproxy.cfg
  systemctl reload haproxy || systemctl restart haproxy
  exit 1
fi
APPLY
chmod +x /usr/local/bin/haproxy-apply
/usr/local/bin/haproxy-apply || echo "haproxy-apply 실패: 나머지 부팅 계속 (#46 보강③)"

# wg-aws 개인키: placeholder면 생성·저장, 아니면 저장된 키 사용
install -d -m 700 /etc/wireguard
set +x
umask 077
KEY=$(/usr/local/bin/ssm-get ${wg_key_param} --with-decryption)
if [ "$KEY" = "placeholder" ]; then
  wg genkey | tr -d '\n' > /etc/wireguard/wg-aws.key
  /snap/bin/aws ssm put-parameter --region ap-northeast-2 \
    --name ${wg_key_param} --type SecureString --overwrite \
    --value "file:///etc/wireguard/wg-aws.key"
else
  printf '%s' "$KEY" > /etc/wireguard/wg-aws.key
fi
unset KEY
umask 022
set -x

# wg-aws 설정 적용: 부팅 때와 Run Command(피어 변경) 때 같이 사용
cat > /usr/local/bin/wg-apply <<'WG'
#!/bin/bash
set -euo pipefail
umask 077
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
/usr/local/bin/ssm-get ${wg_peers_param} | cat > "$tmp"
[ -s "$tmp" ] || { echo "빈 피어 목록 수신, 중단" >&2; exit 1; }
{
  echo "[Interface]"
  echo "Address = ${wg_address}/32"
  echo "ListenPort = 51820"
  echo "MTU = 1420"                            # 거점과 맞춤 (#55와 동일)
  echo "PrivateKey = $(cat /etc/wireguard/wg-aws.key)"
  echo
  cat "$tmp"
} > /etc/wireguard/wg-aws.conf
if systemctl is-active --quiet wg-quick@wg-aws; then
  wg syncconf wg-aws <(wg-quick strip wg-aws)  # 연결 유지, 피어만 갱신
else
  systemctl enable --now wg-quick@wg-aws
fi
# syncconf는 라우트를 안 만듦 → 피어 대역마다 라우트 보장 (허브 11/25 교훈)
wg show wg-aws allowed-ips | awk '{for(i=2;i<=NF;i++) print $i}' | \
  while read -r net; do ip route replace "$net" dev wg-aws; done
WG
chmod +x /usr/local/bin/wg-apply
/usr/local/bin/wg-apply

# --- Tailscale: tag:edge 삭제로 현재 가입 실패, 팀 답변 후 정리 (실패해도 계속) ---
curl -fsSL https://tailscale.com/install.sh | sh || echo "Tailscale 설치 실패"
set +x
if TS_KEY=$(/usr/local/bin/ssm-get ${ts_param} --with-decryption) && \
   tailscale up --authkey "$TS_KEY" --hostname ${hostname} \
     --advertise-tags=tag:edge --accept-routes; then
  echo "Tailscale 가입 완료"
else
  echo "Tailscale 가입 실패: 무시 (#46)"
fi
unset TS_KEY
set -x
